#!/usr/bin/env bash
#
# The validation gate.
#
# Usage:
#   bin/verify            lint, static analysis (level 6, plus level 8's null/false checks), unit tests, build
#   bin/verify --all      also run thread and workflow suites (needs WP_TESTS_DIR)
#
set -euo pipefail
cd "$(dirname "$0")/.."

# Uses PHP 8.2 when present, otherwise the PHP on PATH.
PHP="${BE_PHP:-}"
if [ -z "$PHP" ] && [ -x /opt/homebrew/opt/php@8.2/bin/php ]; then
    PHP=/opt/homebrew/opt/php@8.2/bin/php
fi
[ -n "$PHP" ] || PHP="$(command -v php)"
RUN_ALL=0
[ "${1:-}" = "--all" ] && RUN_ALL=1

if [ -z "$PHP" ] || [ ! -x "$PHP" ]; then
    echo "No php binary found. Set BE_PHP or put php on PATH." >&2
    exit 1
fi

PHP_VER="$("$PHP" -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')"
if [ "$PHP_VER" != "8.2" ]; then
    echo "note: running on PHP $PHP_VER; production is 8.2. PHPStan enforces the 8.2 target."
fi

echo "==> php -l (PHP $("$PHP" -r 'echo PHP_VERSION;'))"
find beyond-elysium/includes beyond-elysium/mu-plugin -name '*.php' -not -path '*/accessschema-client/*' -print0 \
    | xargs -0 -n1 "$PHP" -l > /dev/null
"$PHP" -l beyond-elysium/beyond-elysium.php > /dev/null
echo "    ok"

# Runs PHPStan and shows its output only when it fails.
run_phpstan() {
    local out
    if ! out="$("$PHP" beyond-elysium/vendor/bin/phpstan analyse --no-progress --memory-limit=1G "$@" 2>&1)"; then
        printf '%s\n' "$out" >&2
        exit 1
    fi
}

echo "==> phpstan (level 6)"
run_phpstan

echo "==> phpstan (null and false handling, level 8)"
run_phpstan -c phpstan-null-safety.neon

echo "==> phpunit :: unit"
"$PHP" beyond-elysium/vendor/bin/phpunit --testsuite unit --no-coverage

if [ "$RUN_ALL" = "1" ]; then
    if [ -z "${WP_TESTS_DIR:-}" ]; then
        echo "==> phpunit :: thread + workflow  SKIPPED (WP_TESTS_DIR is not set)"
    else
        echo "==> phpunit :: thread"
        "$PHP" beyond-elysium/vendor/bin/phpunit --testsuite thread --no-coverage
        echo "==> phpunit :: workflow"
        "$PHP" beyond-elysium/vendor/bin/phpunit --testsuite workflow --no-coverage

        # A @group multisite case needs a real multisite install, which WP_TESTS_DIR's own single-site one is not -
        # it runs instead against a second, dedicated wp-tests-config naming its own database.
        MS_CONFIG="${BE_WP_TESTS_MULTISITE_CONFIG:-$(dirname "$(dirname "$WP_TESTS_DIR")")/wp-tests-config-multisite.php}"
        if [ ! -f "$MS_CONFIG" ]; then
            echo "==> phpunit :: thread (multisite)  SKIPPED (no wp-tests-config-multisite.php at $MS_CONFIG)"
        else
            echo "==> phpunit :: thread (multisite)"
            WP_TESTS_CONFIG_FILE_PATH="$MS_CONFIG" "$PHP" beyond-elysium/vendor/bin/phpunit --testsuite thread --group multisite --no-coverage
        fi
    fi
fi

if [ ! -d node_modules ]; then
    echo "    node_modules missing - running npm install first"
    npm install --silent
fi

echo "==> npm run check-types"
npm run check-types --silent

echo "==> npm run lint:js"
npm run lint:js --silent

echo "==> npm run lint:css"
npm run lint:css --silent

echo "==> npm test"
npm test --silent

echo "==> doc links"
node bin/check-doc-links.js

# Validates every declared catalog file.
"$PHP" bin/validate-catalog

echo "==> npm run build"
npm run build --silent

./bin/check-translations

echo
echo "all green"
