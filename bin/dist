#!/usr/bin/env bash
#
# Build a deployable plugin artifact.
#
# The artifact carries build/ and vendor/ (which are gitignored) and excludes everything in
# .distignore - the Grapevine source, the planning docs, tests and tooling.
#
# Leaves the working tree with dev dependencies reinstalled.
#
set -euo pipefail
cd "$(dirname "$0")/.."

# Prefer the PHP that matches production (8.2). Falls back to whatever is on PATH.
PHP="${BE_PHP:-}"
if [ -z "$PHP" ] && [ -x /opt/homebrew/opt/php@8.2/bin/php ]; then
    PHP=/opt/homebrew/opt/php@8.2/bin/php
fi
[ -n "$PHP" ] || PHP="$(command -v php)"

VERSION="$(grep -oE "BE_VERSION', '[^']+" beyond-elysium/beyond-elysium.php | cut -d"'" -f3)"
if [ -z "$VERSION" ]; then
    echo "Could not read BE_VERSION from beyond-elysium/beyond-elysium.php" >&2
    exit 1
fi

OUT="dist/beyond-elysium"
echo "==> building beyond-elysium $VERSION"

echo "==> composer install --no-dev"
composer install --no-dev --optimize-autoloader --quiet

echo "==> npm run build"
[ -d node_modules ] || npm install --silent
npm run build --silent

# Step 11d, workflow-0.9.md: generated here, after the build above, not committed - a .pot
# built from source .tsx directly would miss every React string (wp i18n make-pot scans .js,
# not .tsx; it does pick these up because webpack's own build/*.js output still carries each
# __()/_n()/sprintf() call as readable text even minified). Generating it fresh on every
# bin/dist run is what keeps the template from silently drifting out of date, rather than a
# committed file nobody remembers to regenerate.
WP_CLI="${BE_WP_CLI:-}"
if [ -z "$WP_CLI" ] && [ -x /opt/homebrew/Cellar/wp-cli/2.12.0/bin/wp ]; then
    WP_CLI=/opt/homebrew/Cellar/wp-cli/2.12.0/bin/wp
fi
[ -n "$WP_CLI" ] || WP_CLI="$(command -v wp)"

echo "==> wp i18n make-pot"
mkdir -p beyond-elysium/languages
"$PHP" "$WP_CLI" i18n make-pot beyond-elysium beyond-elysium/languages/beyond-elysium.pot \
    --domain=beyond-elysium \
    --exclude=vendor \
    --quiet

# Real translation files (.po), unlike the .pot above, are committed content, not regenerated
# here - i18n-pt-br-design.md. Compile each into what WordPress actually loads at runtime:
# a .mo for load_plugin_textdomain() (PHP/gettext strings) and per-script-handle .json files
# for wp_set_script_translations() (the React-side strings, registered for both the
# 'beyond-elysium' and 'beyond-elysium-admin' handles in Plugin.php/Admin_Menu.php). A locale
# with no .po yet is skipped silently - same graceful English-fallback as no translation at all.
for po in beyond-elysium/languages/*.po; do
    [ -e "$po" ] || continue
    locale="$(basename "$po" .po | sed 's/^beyond-elysium-//')"
    echo "==> wp i18n make-mo/make-json ($locale)"
    "$PHP" "$WP_CLI" i18n make-mo "$po" beyond-elysium/languages/ --quiet
    "$PHP" "$WP_CLI" i18n make-json "$po" beyond-elysium/languages/ --no-purge --quiet
done

echo "==> assembling"
rm -rf dist
mkdir -p "$OUT"
rsync -a --exclude-from=.distignore beyond-elysium/ "$OUT/"

# Signed-PDF (SP-2): TCPDF's fonts/ ships 165 files, ~24 MB, for font families this plugin
# never selects. Base-14 (helvetica/times/courier/symbol/zapfdingbats - no embedded font
# program, every PDF reader already has them) plus DejaVu Sans (the one Unicode-capable
# family Pdf_Writer actually uses, so non-Latin-1 chronicle/player/trait names print
# correctly instead of mojibake) is everything real output needs.
TCPDF_FONTS="$OUT/vendor/tecnickcom/tcpdf/fonts"
if [ -d "$TCPDF_FONTS" ]; then
    find "$TCPDF_FONTS" -maxdepth 1 -type f ! \( \
        -name 'helvetica*.php' -o \
        -name 'times*.php' -o \
        -name 'courier*.php' -o \
        -name 'symbol.php' -o \
        -name 'zapfdingbats.php' -o \
        -name 'dejavusans.*' -o \
        -name 'dejavusansb.*' -o \
        -name 'dejavusansi.*' -o \
        -name 'dejavusansbi.*' \
    \) -delete
    # TCPDF also ships per-family source/license subdirectories alongside fonts/ itself
    # (ae_fonts_2.0, dejavu-fonts-ttf-2.3x, freefont-*) - the file-level prune above never
    # touches these since find -type f skips directories, and none of the kept families
    # loads anything from them at runtime (TCPDF reads only the flat .php/.z/.ctg.z files).
    find "$TCPDF_FONTS" -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} +
fi

# These must be present or the plugin fatals on activation.
for required in "vendor/autoload.php" "build/index.js" "beyond-elysium.php" "includes/Core/Plugin.php"; do
    if [ ! -f "$OUT/$required" ]; then
        echo "MISSING from artifact: $required" >&2
        exit 1
    fi
done

# The font prune above must keep exactly these and nothing else - present-and-absent,
# matching this script's own existing pattern, not just "the directory got smaller."
for required_font in helvetica helveticab helveticabi helveticai times timesb timesbi timesi \
    courier courierb courierbi courieri symbol zapfdingbats dejavusans dejavusansb dejavusansi dejavusansbi; do
    if [ ! -f "$TCPDF_FONTS/${required_font}.php" ]; then
        echo "MISSING required TCPDF font: ${required_font}.php" >&2
        exit 1
    fi
done
for forbidden_font in dejavusanscondensed dejavusansmono dejavusansextralight; do
    if [ -f "$TCPDF_FONTS/${forbidden_font}.php" ]; then
        echo "LEAKED unused TCPDF font family into artifact: ${forbidden_font}" >&2
        exit 1
    fi
done
if [ -n "$(find "$TCPDF_FONTS" -mindepth 1 -maxdepth 1 -type d)" ]; then
    echo "LEAKED TCPDF font source/license subdirectory into artifact" >&2
    exit 1
fi

# Not required for the plugin to run (a missing .pot just means no translator has anything
# to work from yet - same graceful English-fallback as a missing .mo, Step 11e) - but its
# absence here means make-pot silently failed above, worth catching now rather than as a
# translator's own bug report months later.
if [ ! -f "$OUT/languages/beyond-elysium.pot" ]; then
    echo "MISSING from artifact: languages/beyond-elysium.pot" >&2
    exit 1
fi

# These must NOT be present.
for forbidden in "GV301Source" "BE_PROCESS" "tests" "node_modules" ".git" "pp-samples" "data-samples"; do
    if [ -e "$OUT/$forbidden" ]; then
        echo "LEAKED into artifact: $forbidden" >&2
        exit 1
    fi
done

echo "==> packaging"
( cd dist && zip -qr "beyond-elysium-${VERSION}.zip" beyond-elysium )

echo "==> restoring dev dependencies"
composer install --quiet

echo
echo "  artifact : dist/beyond-elysium-${VERSION}.zip"
echo "  unpacked : $(du -sh "$OUT" | cut -f1)"
echo "  zipped   : $(du -h "dist/beyond-elysium-${VERSION}.zip" | cut -f1)"
