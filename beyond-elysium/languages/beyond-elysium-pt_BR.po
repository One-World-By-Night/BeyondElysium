msgid "Verification code"
msgstr "Código de verificação"

#: build/997.js:1
msgid "Check"
msgstr "Verificar"

#: build/997.js:1
msgid ""
"This code doesn't match any verification record. Check it was typed "
"correctly."
msgstr ""
"Este código não corresponde a nenhum registro de verificação. Verifique se "
"foi digitado corretamente."

