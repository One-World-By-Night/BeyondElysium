{
    "resolveCrossBlockValue": [
        {
            "name": "reads a plain identity_field value",
            "ref": { "block_slug": "vampire-identity", "field": "Morality Path" },
            "sheetData": { "vampire-identity": { "Morality Path": "Path of Caine" } }
        },
        {
            "name": "reads a resource_pool value by its permanent rating, not the whole object",
            "ref": { "block_slug": "vampire-resources", "field": "Morality" },
            "sheetData": { "vampire-resources": { "Morality": { "permanent": 8, "temporary": 8 } } }
        },
        {
            "name": "returns null when the block is absent",
            "ref": { "block_slug": "vampire-identity", "field": "Morality Path" },
            "sheetData": {}
        },
        {
            "name": "returns null when the field is unset (no Path chosen yet)",
            "ref": { "block_slug": "vampire-identity", "field": "Morality Path" },
            "sheetData": { "vampire-identity": { "Clan": "Ventrue" } }
        },
        {
            "name": "returns null for an empty string, not the literal \"\"",
            "ref": { "block_slug": "vampire-identity", "field": "Morality Path" },
            "sheetData": { "vampire-identity": { "Morality Path": "" } }
        }
    ],
    "resolveSectionTitle": [
        {
            "name": "returns the bare title when title_refs is unset - every section authored before this field existed",
            "section": { "block_slug": "x", "column": 1, "order": 1, "title": "Virtues", "display": null, "collapsed": false },
            "sheetData": {}
        },
        {
            "name": "appends every resolved ref, space-joined, when all resolve",
            "section": {
                "block_slug": "x", "column": 1, "order": 1, "title": "Virtues", "display": null, "collapsed": false,
                "title_refs": [
                    { "block_slug": "vampire-identity", "field": "Morality Path" },
                    { "block_slug": "vampire-resources", "field": "Morality" }
                ]
            },
            "sheetData": {
                "vampire-identity": { "Morality Path": "Path of Caine" },
                "vampire-resources": { "Morality": { "permanent": 8, "temporary": 8 } }
            }
        },
        {
            "name": "falls back to the bare title the moment any one ref fails to resolve - no Path chosen yet",
            "section": {
                "block_slug": "x", "column": 1, "order": 1, "title": "Virtues", "display": null, "collapsed": false,
                "title_refs": [
                    { "block_slug": "vampire-identity", "field": "Morality Path" },
                    { "block_slug": "vampire-resources", "field": "Morality" }
                ]
            },
            "sheetData": {
                "vampire-resources": { "Morality": { "permanent": 7, "temporary": 7 } }
            }
        }
    ],
    "resolvePoolName": [
        {
            "name": "returns the plain name when name_lookup is unset - every pool authored before this field existed",
            "pool": { "name": "Conscience", "value_type": "integer", "default_start": 1 },
            "sheetData": {}
        },
        {
            "name": "returns the looked-up override when the keyed value has a table entry",
            "pool": {
                "name": "Conscience", "value_type": "integer", "default_start": 1,
                "name_lookup": {
                    "keyed_by": { "block_slug": "vampire-identity", "field": "Morality Path" },
                    "table": { "Path of Caine": "Conviction" }
                }
            },
            "sheetData": { "vampire-identity": { "Morality Path": "Path of Caine" } }
        },
        {
            "name": "falls back to the plain name when the keyed value has no table entry (e.g. Humanity)",
            "pool": {
                "name": "Conscience", "value_type": "integer", "default_start": 1,
                "name_lookup": {
                    "keyed_by": { "block_slug": "vampire-identity", "field": "Morality Path" },
                    "table": { "Path of Caine": "Conviction" }
                }
            },
            "sheetData": { "vampire-identity": { "Morality Path": "Humanity" } }
        },
        {
            "name": "falls back to the plain name when no Path has been chosen at all",
            "pool": {
                "name": "Conscience", "value_type": "integer", "default_start": 1,
                "name_lookup": {
                    "keyed_by": { "block_slug": "vampire-identity", "field": "Morality Path" },
                    "table": { "Path of Caine": "Conviction" }
                }
            },
            "sheetData": {}
        },
        {
            "name": "never changes the pool's own name field - only what a caller displays",
            "pool": {
                "name": "Conscience", "value_type": "integer", "default_start": 1,
                "name_lookup": {
                    "keyed_by": { "block_slug": "vampire-identity", "field": "Morality Path" },
                    "table": { "Path of Caine": "Conviction" }
                }
            },
            "sheetData": { "vampire-identity": { "Morality Path": "Path of Caine" } }
        }
    ]
}
